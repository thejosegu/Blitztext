<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WapProjPath>$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
  </PropertyGroup>

  <Import Project="$(WapProjPath)Microsoft.DesktopBridge.props" Condition="Exists('$(WapProjPath)Microsoft.DesktopBridge.props')" />

  <PropertyGroup>
    <ProjectGuid>5B3EB5E6-8BE8-4FB5-90D2-9F25D2F0A6B7</ProjectGuid>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <DefaultLanguage>de-DE</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <EntryPointProjectUniqueName>..\Blitztext.csproj</EntryPointProjectUniqueName>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <PackageCertificateThumbprint></PackageCertificateThumbprint>
    <PackageProjectUrl>https://github.com/placeholder/blitztext</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Images\StoreLogo.png" />
    <Content Include="Images\Square44x44Logo.png" />
    <Content Include="Images\Square150x150Logo.png" />
    <Content Include="Images\Wide310x150Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blitztext.csproj" />
  </ItemGroup>

  <Import Project="$(WapProjPath)Microsoft.DesktopBridge.targets" Condition="Exists('$(WapProjPath)Microsoft.DesktopBridge.targets')" />

  <Target Name="Publish" Condition="!Exists('$(WapProjPath)Microsoft.DesktopBridge.targets')">
    <Message Importance="high" Text="Überspringe MSIX-Publish für Blitztext.Package: Microsoft Desktop Bridge targets sind in dieser Umgebung nicht installiert." />
  </Target>

  <Target Name="EnsureDesktopBridgeTargets" BeforeTargets="Build" Condition="!Exists('$(WapProjPath)Microsoft.DesktopBridge.targets')">
    <Error Text="Microsoft Desktop Bridge targets wurden nicht gefunden. Installiere in Visual Studio die MSIX Packaging Tools bzw. den Windows Application Packaging Project Support." />
  </Target>
</Project>